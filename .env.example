# Copy this file to ".env" and fill in your key. The .env file is gitignored.

# Your DeepSeek API key (required).
DEEPSEEK_API_KEY=your-key-here

# Optional overrides:
# MINDWEAVE_MODEL — which DeepSeek model to use. Defaults to deepseek-v4-flash.
#   deepseek-v4-flash  fast & cheap (default)
#   deepseek-v4-pro    stronger, pricier
# MINDWEAVE_MODEL=deepseek-v4-flash
# MINDWEAVE_BASE_URL=https://api.deepseek.com
