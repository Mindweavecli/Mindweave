# Copy this file to ".env" and fill in a key. The .env file is gitignored.
#
# You only need a key for the provider whose models you actually use. Set both
# and you can switch between them with /model in the same project.

# DeepSeek (the default provider).
DEEPSEEK_API_KEY=your-key-here

# Anthropic (Claude).
# ANTHROPIC_API_KEY=your-key-here

# Optional overrides:
# MINDWEAVE_MODEL — which model to start with. Defaults to deepseek-v4-flash.
#   deepseek-v4-flash  fast & cheap (default)
#   deepseek-v4-pro    stronger, pricier
#   claude-sonnet-5    fast, strong at code
#   claude-opus-5      most capable
# MINDWEAVE_MODEL=deepseek-v4-flash
#
# MINDWEAVE_BASE_URL — override the DeepSeek endpoint only.
# MINDWEAVE_BASE_URL=https://api.deepseek.com
